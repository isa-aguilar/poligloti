# poligloti configuration. Copy to .env and fill in.
# Three independent OpenAI-compatible services. Mix them as you like: chat in
# the cloud and voice on your machine, or the other way round.

# --- Chat (required) --------------------------------------------------------
# Local Ollama:   AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.2:3b
# OpenAI:         AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_MODEL=
# Leave empty for local servers that do not ask for one.
AI_API_KEY=
# Optional: a vision-capable model on the same server, to read a book page from
# a photo. Without it that option is hidden.
AI_VISION_MODEL=
# How to ask for JSON: auto (try response_format, fall back if rejected),
# json_object, gbnf (llama.cpp servers only), off.
AI_JSON_MODE=auto

# --- Speech-to-text (optional: without it you practice by typing) -----------
# STT_BASE_URL and STT_API_KEY default to the AI_* values above.
# Local speaches:  STT_BASE_URL=http://localhost:8000/v1  STT_MODEL=Systran/faster-whisper-small
# OpenAI:          STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Pronunciation practice needs per-word timestamps: auto, true or false.
STT_WORD_TIMESTAMPS=auto

# --- Text-to-speech (optional: without it the browser reads replies aloud) --
# TTS_BASE_URL and TTS_API_KEY default to the AI_* values above.
# Voices per language, comma separated, the first one is the default. A
# language without a voice uses the browser voice.
# OpenAI: TTS_MODEL=tts-1, voices such as alloy, nova, shimmer (all languages).
# speaches with Piper: every voice is its own model, so set it per language
# with TTS_MODEL_<LANG> (see README, "Local AI with Docker").
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_MODEL_DE=
TTS_MODEL_EN=
TTS_MODEL_FR=
TTS_VOICE_DE=
TTS_VOICE_EN=
TTS_VOICE_FR=

# --- App --------------------------------------------------------------------
# Language of explanations and corrections: en, es or de.
SUPPORT_LANG=en
# Where learner profiles and progress are stored (plain markdown files).
DATA_DIR=./data
# Listen on localhost only. There is no login: never expose it to the internet.
HOST=127.0.0.1
PORT=8100
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Other tunables (defaults in backend/config.py): MAX_CORRECTIONS=3,
# AI_TEMPERATURE=0.4, AI_MAX_TOKENS=320, AI_TIMEOUT=120, STT_TIMEOUT=120,
# TTS_TIMEOUT=120, SESSION_TTL_S=7200. Raise the timeouts on slow CPU-only setups.
